{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "userDetailsClaim": "preferred_username",
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/c8a07bc3-1bfe-4411-b3ae-a8828fb73d9a/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/403.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/403.css",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/teams.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com https://*.skype.com https://*.cloud.microsoft https://*.microsoft365.com https://*.office.com"
      }
    },
    {
      "route": "/teams.js",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/app.js",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/styles.css",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/vendor/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/teams/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/login",
      "rewrite": "/.auth/login/aad"
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout"
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html",
      "statusCode": 403
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
